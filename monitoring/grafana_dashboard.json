{
  "uid": "c1b-credit-risk",
  "title": "C1B Credit Risk Platform — Production Overview",
  "tags": ["c1b", "credit-risk", "fintech", "lightgbm"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API p95 latency",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(c1b_api_request_latency_seconds_bucket[5m])))",
        "legendFormat": "p95",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null},
        {"color": "yellow", "value": 0.3},
        {"color": "red", "value": 0.5}
      ]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API error rate (5 m)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "c1b_api_error_rate", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null},
        {"color": "red", "value": 0.01}
      ]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model ROC-AUC",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "c1b_model_roc_auc", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [
        {"color": "red", "value": null},
        {"color": "yellow", "value": 0.85},
        {"color": "green", "value": 0.95}
      ]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "AUC drift",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "c1b_model_auc_drift", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null},
        {"color": "red", "value": 0.05}
      ]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API latency percentiles",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(c1b_api_request_latency_seconds_bucket[5m])))", "legendFormat": "p50 {{endpoint}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(c1b_api_request_latency_seconds_bucket[5m])))", "legendFormat": "p95 {{endpoint}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(c1b_api_request_latency_seconds_bucket[5m])))", "legendFormat": "p99 {{endpoint}}", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Risk tier distribution",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "c1b_risk_tier_pct{tier=\"low\"}",    "legendFormat": "Low",    "refId": "A"},
        {"expr": "c1b_risk_tier_pct{tier=\"medium\"}", "legendFormat": "Medium", "refId": "B"},
        {"expr": "c1b_risk_tier_pct{tier=\"high\"}",   "legendFormat": "High",   "refId": "C"},
        {"expr": "c1b_risk_tier_high_threshold", "legendFormat": "High tier alert threshold (75%)", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Risk tier drift (vs MLflow baseline)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 7},
      "targets": [
        {"expr": "c1b_risk_tier_drift_pct{tier=\"low\"}",    "legendFormat": "Low drift",    "refId": "A"},
        {"expr": "c1b_risk_tier_drift_pct{tier=\"medium\"}", "legendFormat": "Medium drift", "refId": "B"},
        {"expr": "c1b_risk_tier_drift_pct{tier=\"high\"}",   "legendFormat": "High drift",   "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests / sec by status class",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 7},
      "targets": [
        {"expr": "sum by (status_class) (rate(c1b_api_requests_total[1m]))", "legendFormat": "{{status_class}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    }
  ]
}
